{
  "name": "pi-session-history",
  "version": "0.1.0",
  "description": "Search, inspect, and resume historical Pi coding-agent sessions.",
  "type": "module",
  "license": "MIT",
  "author": "yoyooyooo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyooyooo/pi-session-history.git"
  },
  "homepage": "https://github.com/yoyooyooo/pi-session-history#readme",
  "bugs": {
    "url": "https://github.com/yoyooyooo/pi-session-history/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "session-history",
    "agent-history",
    "coding-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/index.ts",
    "src/history.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "release": "tsx scripts/release.ts",
    "release:check": "tsx scripts/release.ts --precheck"
  },
  "dependencies": {
    "@letta-ai/trajectory": "0.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^26.1.1",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.6",
    "typebox": "1.1.38",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
